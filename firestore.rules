rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data, admins can read all users
      allow read: if request.auth != null && 
        (request.auth.uid == userId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Users can only create their own document
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can update their name/photo/favorites but NOT their role
      allow update: if request.auth != null && 
        (request.auth.uid == userId && 
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstname', 'lastname', 'photoURL', 'email', 'favorites'])) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // Only admins can delete users (but not themselves)
      allow delete: if request.auth != null && 
        request.auth.uid != userId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Courses collection
    match /courses/{courseId} {
      // Anyone (authenticated or not) can read courses
      allow read: if true;
      
      // Only admins can create, update, or delete courses
      allow create, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Bugs collection
    match /bugs/{bugId} {
      // Anyone can create a bug report
      allow create: if true;
      
      // Users can read their own bugs, admins can read all
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Only admins can update or delete bug reports
      allow update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Reminders collection
    match /reminders/{reminderId} {
      // Anyone can read reminders (displayed on homepage)
      allow read: if true;
      
      // Only admins can create, update, or delete reminders
      allow create, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Flashcards collection
    match /flashcards/{flashcardId} {
      // Anyone can read flashcards (accessible to all visitors)
      allow read: if true;
      
      // Only admins can create, update, or delete flashcards
      allow create, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User flashcard progress (subcollection under users)
    match /users/{userId}/flashcardProgress/{flashcardId} {
      // Users can read and write only their own progress
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Quizzes collection
    match /quizzes/{quizId} {
        // Authenticated users can read quizzes
        allow read: if request.auth != null;
        
        // Only admins can create, update, or delete quizzes
        allow create, update, delete: if request.auth != null && 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Quiz Results collection
    match /quiz_results/{resultId} {
        // Users can read/write their own results
        allow read, create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
        // Admins can read all results
        allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Badges collection (badge definitions)
    match /badges/{badgeId} {
      // Anyone can read badge definitions
      allow read: if true;
      
      // Only admins can create, update, or delete badges
      allow create, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User badges (unlocked badges)
    match /users/{userId}/userBadges/{badgeId} {
      // Users can read their own badges, admins can read all
      allow read: if request.auth != null && 
        (request.auth.uid == userId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Users can create badges for themselves (unlocking)
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // No updates or deletes allowed (badges are permanent)
    }

    // Course Views collection (tracking who viewed courses)
    match /courseViews/{viewId} {
      // Only authenticated users can read course views
      allow read: if request.auth != null;
      
      // Users can create/update their own views
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
  }
}
