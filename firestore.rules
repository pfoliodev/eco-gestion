rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if the current user is an admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      // Allow authenticated users to read profiles (Name, Avatar, Stats)
      allow read: if request.auth != null;
      // Users can write their own document
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Admin can read, update, delete ANY user
      allow update, delete: if isAdmin();
      
      // User succes subcollection
      match /userSucces/{succesId} {
        // Allow public read for leaderboard
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // User flashcard progress subcollection
      match /flashcardProgress/{flashcardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User inventory subcollection
      match /inventory/{itemId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
      
      // User transactions subcollection
      match /transactions/{transactionId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && request.auth.uid == userId;
      }

      // User Gym Badges subcollection
      match /gymBadges/{badgeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Quiz Results collection
    match /quiz_results/{resultId} {
        // Allow public read for leaderboard stats (or restrict to counting if possible, but read is standard)
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
        
        // Admins can read all results
        allow list, delete: if isAdmin();
    }

    // Professor Dialogues
    match /professor_dialogues/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Bugs collection
    match /bugs/{bugId} {
      allow create: if true;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Reminders collection
    match /reminders/{reminderId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Flashcards collection
    match /flashcards/{flashcardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Quizzes collection
    match /quizzes/{quizId} {
        allow read: if request.auth != null;
        allow create, update, delete: if isAdmin();
    }

    // Evaluations collection
    match /evaluations/{evalId} {
        allow read: if request.auth != null;
        allow create, update, delete: if isAdmin();
    }

    // Succes collection (succes definitions)
    match /succes/{succesId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Course Views collection (tracking who viewed courses)
    match /courseViews/{viewId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Site Visits collection (Unique Visitors)
    match /site_visits/{userId} {
      // Allows counting documents for stats
      allow read: if request.auth != null;
      // Users can only mark their own visit
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // Collection Group Rule for userSucces (required for Pantheon leaderboard)
    match /{path=**}/userSucces/{succesId} {
      allow read: if request.auth != null;
    }

    // Collection Group Rule for gymBadges
    match /{path=**}/gymBadges/{badgeId} {
      allow read: if request.auth != null;
    }

    // Settings collection (feature flags)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    // ============================================
    // IFH COINS SYSTEM
    // ============================================

    // Shop Items (public catalog) - using shopItems as collection name
    match /shopItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Shop Items - alternative collection name (shop_items with underscore)
    match /shop_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Coin Transactions (global transaction log)
    match /coin_transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Admins can read all transactions
      allow read: if isAdmin();
      // System creates transactions
      allow create: if request.auth != null;
    }

    // Pets (user pets collection)
    match /pets/{petId} {
      // Users can read/write their own pets
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Admins can read, write, and create all pets (needed for migration)
      allow read, write, create: if isAdmin();
    }

    // Favorites (user favorites)
    match /favorites/{favoriteId} {
      // Users can read/write their own favorites
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Admins can read all favorites
      allow read: if isAdmin();
    }

    // Trade Offers
    match /tradeOffers/{offerId} {
      // Users can read their own offers (sent or received)
      allow read: if request.auth != null && 
        (resource.data.fromUserId == request.auth.uid || 
         resource.data.toUserId == request.auth.uid);
      // Users can create offers from themselves
      allow create: if request.auth != null && 
        request.resource.data.fromUserId == request.auth.uid;
      // Users can update offers they're involved in (accept/reject/cancel)
      allow update: if request.auth != null && 
        (resource.data.fromUserId == request.auth.uid || 
         resource.data.toUserId == request.auth.uid);
      // Admin can read all trades
      allow read: if isAdmin();
    }
  }
}
