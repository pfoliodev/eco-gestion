rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if the current user is an admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      // Basic self-access (Always check this FIRST to avoid isAdmin recursion)
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      
      // Admin access (to OTHER users only to avoid recursion)
      allow read, update, delete: if request.auth != null && request.auth.uid != userId && isAdmin();
      
      // User badges subcollection
      match /userBadges/{badgeId} {
        allow read, create, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // User flashcard progress subcollection
      match /flashcardProgress/{flashcardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Quiz Results collection
    match /quiz_results/{resultId} {
        // Users can read/write their own results
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
        allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
        
        // Admins can read all results
        allow read: if isAdmin();
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Bugs collection
    match /bugs/{bugId} {
      allow create: if true;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Reminders collection
    match /reminders/{reminderId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Flashcards collection
    match /flashcards/{flashcardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Quizzes collection
    match /quizzes/{quizId} {
        allow read: if request.auth != null;
        allow create, update, delete: if isAdmin();
    }

    // Badges collection (badge definitions)
    match /badges/{badgeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Course Views collection (tracking who viewed courses)
    match /courseViews/{viewId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Settings collection (feature flags)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
    }
  }
}
