rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data, admins can read all users
      allow read: if request.auth != null && 
        (request.auth.uid == userId || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Users can only create their own document
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can update their name/photo but NOT their role
      allow update: if request.auth != null && 
        (request.auth.uid == userId && 
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstname', 'lastname', 'photoURL', 'email'])) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // Only admins can delete users (but not themselves)
      allow delete: if request.auth != null && 
        request.auth.uid != userId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Courses collection
    match /courses/{courseId} {
      // Anyone (authenticated or not) can read courses
      allow read: if true;
      
      // Only admins can create, update, or delete courses
      allow create, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Bugs collection
    match /bugs/{bugId} {
      // Anyone can create a bug report
      allow create: if true;
      
      // Only admins can read, update, or delete bug reports
      allow read, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Reminders collection
    match /reminders/{reminderId} {
      // Anyone can read reminders (displayed on homepage)
      allow read: if true;
      
      // Only admins can create, update, or delete reminders
      allow create, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Flashcards collection
    match /flashcards/{flashcardId} {
      // Anyone can read flashcards (accessible to all visitors)
      allow read: if true;
      
      // Only admins can create, update, or delete flashcards
      allow create, update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User flashcard progress (subcollection under users)
    match /users/{userId}/flashcardProgress/{flashcardId} {
      // Users can read and write only their own progress
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
